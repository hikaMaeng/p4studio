{
  "name": "@p4studio/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:front && npm run build:server",
    "build:front": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/server/index.cjs",
    "dev": "tsx src/server/dev.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "@p4studio/p4-protocol": "*",
    "@p4studio/studio_domain": "*",
    "@xyflow/react": "12.11.6",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.21.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
